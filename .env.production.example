# Ushbu fayl namuna. Haqiqiy sirlarni repozitoriy ichiga yozmang.
APP_ENV=production
BASE_URL=https://koprik.uz
PRIMARY_DOMAIN=koprik.uz
ALLOWED_HOSTS=koprik.uz,www.koprik.uz,admin.koprik.uz,*.up.railway.app,*.railway.internal,localhost,127.0.0.1
CANONICAL_WWW_REDIRECT=1
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Ixtiyoriy. Bo‘sh bo‘lsa server Telegram getMe orqali aniqlaydi.
BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME
WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
MOBILE_OTP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_TG_IDS=YOUR_ADMIN_TELEGRAM_ID
ADMIN_AUDIT_IP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS

# Railway Volume /data manziliga ulangan bo‘lishi kerak.
PERSISTENT_ROOT=/data
DB_PATH=/data/db/platforma.db
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
PAYMENT_RECEIPT_DIR=/data/private/payment_receipts
PAYMENT_TOKEN_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARS
DATABASE_BACKUP_ON_START=1
BACKUP_RETENTION=14

# Tayyor bo‘limlar ochiq. Zarur bo‘lsa istalganini 0 qilib vaqtincha yoping.
MVP_LISTINGS_ENABLED=1
MVP_STORIES_ENABLED=1
MVP_CHAT_ENABLED=1
MVP_SYSTEMIZATION_ENABLED=1
MVP_TAXI_ENABLED=1

INIT_DATA_MAX_AGE_SEC=86400
PROJECT_ACCESS_RESTRICTED=0
PRIVILEGED_TG_IDS=
PRIVILEGED_DIAGNOSTICS_ENABLED=0
TEST_MODE=0

# Provayderlar keyin ulanadi. Hozir tashqi so‘rov yuborilmaydi.
SMS_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
OBJECT_STORAGE_PROVIDER=disabled

# Ixtiyoriy integratsiyalar:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
